    "test:notification-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-notification-task.test.ps1",
    "lint:php": "node scripts/lint-php-methods.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lint-php-syntax.ps1",
    "check": "npm run lint && npm run typecheck && npm run lint:php && npm run build",
    "xampp:connect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-xampp.ps1",
    "test:e2e": "playwright test"
